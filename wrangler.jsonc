{
  // Static-asset Worker. Cloudflare serves the files in this directory
  // directly from the edge; there is no server-side code in this project.
  "name": "bizveris",
  "compatibility_date": "2026-08-26",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
